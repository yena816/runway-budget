# Copy this file to .env and paste your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The password you'll type to open the app. Pick anything you'll remember.
APP_PASSWORD=change-me

# Used to sign login sessions — any random string works. Generate one with:
# openssl rand -hex 32
SESSION_SECRET=change-me-too
